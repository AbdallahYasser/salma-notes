# Shared password - the only thing gating access. Give this to your friend.
APP_PASSWORD=change-me

# Random secret used to sign the session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated display names offered as "who are you" chips in the UI.
NAMES=Abdullah,Salma

DB_PATH=./data/dev.db
LOG_LEVEL=INFO
SESSION_DAYS=180
